#version 430 core
// One bent light ray per pixel -> uOutput
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image2D uOutput;

uniform vec3 uCameraPos;
// Camera's orthonormal frame, index lowered (xyz spatial, w time); see Kerr
uniform vec4 uFrameTime;
uniform vec4 uFrameRight;
uniform vec4 uFrameUp;
uniform vec4 uFrameForward;
uniform bool uCameraOutside; // false: inside the horizon, all black
uniform float uTanHalfFov;
uniform float uAspect;
uniform float uMass;
uniform float uSpin; // a / M, + turns with the disk about +y
uniform float uHorizon;
uniform float uEscapeRadius;
uniform float uDiskInner; // innermost stable circular orbit
uniform float uDiskOuter;
// Novikov-Thorne flux; see AccretionDisk::flux
uniform float uFluxX0;
uniform vec3 uFluxRoots;
uniform vec3 uFluxCoefficients;
uniform float uFluxScale; // flux at temperature 1
uniform samplerCube uSkybox;
// Coordinate time in rs / c, split so large times keep float precision
uniform float uTimeChunks; // whole multiple of the chunk length
uniform float uTimeRest;   // [0, chunk length)

// Mirrors physics/Kerr.cpp and physics/AccretionDisk.cpp
const float kStepFraction = 0.05; // step length / r
const int kMaxSteps = 500;
const float kDiskPeakKelvin = 4000.0; // artistic; real disks emit X-rays
const float kDiskBrightness = 1.5;
const float kNoiseRadial = 2.0; // noise cells per rs, outwards
const float kNoiseAround = 3.0; // noise-space circle radius
const float kNoiseDepth = 1.0;  // density swing
const float kMaxRadiance = 1e4; // bloom sums 6 levels; stays under half max
const float kTwoPi = 6.28318530718;

// a of the hole the rays are traced in: tracing backwards in time is
// tracing forwards in the time-reversed hole, which spins the other way
float tracedA() { return -uSpin * uMass; }

// Kerr-Schild metric g = eta + f l l at p: Boyer-Lindquist r, its
// spheroid term d = 2 r^2 - |p|^2 + a^2, f and the spatial part of l
void kerrSchild(vec3 p, out float r, out float d, out float f, out vec3 l) {
    float a = tracedA();
    float a2 = a * a;
    float w = dot(p, p) - a2;
    d = sqrt(w * w + 4.0 * a2 * p.y * p.y);
    r = sqrt(0.5 * (w + d));
    float r2 = r * r;
    float n = r2 + a2;
    l = vec3((r * p.x - a * p.z) / n, p.y / r, (r * p.z + a * p.x) / n);
    f = 2.0 * uMass * r2 * r / (r2 * r2 + a2 * p.y * p.y);
}

// Hamilton's equations for H = g^(mu nu) q_mu q_nu / 2 with E = 1;
// also gives the Boyer-Lindquist r
void derivative(vec3 p, vec3 q, out vec3 dPos, out vec3 dMom, out float r) {
    float a = tracedA();
    float a2 = a * a;
    float d, f;
    vec3 l;
    kerrSchild(p, r, d, f, l);
    float r2 = r * r;
    float n = r2 + a2;
    float s = 1.0 + dot(l, q);
    dPos = q - f * s * l;

    vec3 yAxis = vec3(0.0, 1.0, 0.0);
    vec3 gradR = (r2 * p + a2 * p.y * yAxis) / (r * d);
    float m = r2 * r2 + a2 * p.y * p.y;
    vec3 gradF = 2.0 * uMass *
                 (r2 * (3.0 * a2 * p.y * p.y - r2 * r2) * gradR -
                  2.0 * a2 * p.y * r2 * r * yAxis) /
                 (m * m);
    float radialPart = p.x * q.x + p.z * q.z;
    float numerator = r * radialPart + a * (p.x * q.z - p.z * q.x);
    vec3 gradNumerator = radialPart * gradR + r * vec3(q.x, 0.0, q.z) +
                         a * vec3(q.z, 0.0, -q.x);
    vec3 gradLq = gradNumerator / n - numerator * 2.0 * r * gradR / (n * n) +
                  q.y * yAxis / r - p.y * q.y * gradR / r2;
    dMom = 0.5 * s * s * gradF + f * s * gradLq;
}

// Page-Thorne bracket over x^4 (x^3 - 3x + 2a), x = sqrt(r / M)
float diskFlux(float r) {
    float x = sqrt(r / uMass);
    float bracket = x - uFluxX0 - 1.5 * uSpin * log(x / uFluxX0);
    for (int i = 0; i < 3; ++i) {
        bracket -= uFluxCoefficients[i] *
                   log((x - uFluxRoots[i]) / (uFluxX0 - uFluxRoots[i]));
    }
    float x2 = x * x;
    return bracket / (x2 * x2 * (x2 * x - 3.0 * x + 2.0 * uSpin));
}

// Peak 1 without spin; hotter with
float diskTemperature(float r) {
    if (r <= uDiskInner) {
        return 0.0;
    }
    return pow(max(diskFlux(r) / uFluxScale, 0.0), 0.25);
}

// Keplerian d(phi)/dt, coordinate time
float angularVelocity(float r) {
    float sqrtM = sqrt(uMass);
    return sqrtM / (r * sqrt(r) + uSpin * uMass * sqrtM);
}

// dt/d(tau) of the gas on its circular orbit
float orbitTimeRate(float r) {
    float sqrtR = sqrt(r);
    float aSqrtM = uSpin * uMass * sqrt(uMass);
    return (r * sqrtR + aSqrtM) /
           (pow(r, 0.75) *
            sqrt(r * sqrtR - 3.0 * uMass * sqrtR + 2.0 * aSqrtM));
}

// Observed / emitted energy; lambda = L_y / E of the real photon
float redshiftFactor(float r, float lambda, float cameraEnergy) {
    return cameraEnergy /
           (orbitTimeRate(r) * (1.0 - angularVelocity(r) * lambda));
}

// Approximate blackbody color (Tanner Helland fit)
vec3 blackbody(float kelvin) {
    float t = kelvin / 100.0;
    vec3 c;
    c.r = t <= 66.0 ? 255.0 : 329.698727446 * pow(t - 60.0, -0.1332047592);
    c.g = t <= 66.0 ? 99.4708025861 * log(t) - 161.1195681661
                    : 288.1221695283 * pow(t - 60.0, -0.0755148492);
    c.b = t >= 66.0   ? 255.0
          : t <= 19.0 ? 0.0
                      : 138.5177312231 * log(t - 10.0) - 305.0447927307;
    return clamp(c / 255.0, 0.0, 1.0);
}

// Hash -> [0, 1) (Inigo Quilez)
float hash(vec3 p) {
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

// Smooth value noise, [0, 1]
float valueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    vec2 e = vec2(1.0, 0.0);
    return mix(mix(mix(hash(i), hash(i + e.xyy), f.x),
                   mix(hash(i + e.yxy), hash(i + e.xxy), f.x), f.y),
               mix(mix(hash(i + e.yyx), hash(i + e.xyx), f.x),
                   mix(hash(i + e.yxx), hash(i + e.xxx), f.x), f.y),
               f.z);
}

// 4 octaves, [0, 1]
float fbm(vec3 p) {
    float sum = 0.0;
    float amplitude = 0.5;
    for (int i = 0; i < 4; ++i) {
        sum += amplitude * valueNoise(p);
        p = p * 2.03 + 17.0; // offset: octaves don't line up
        amplitude *= 0.5;
    }
    return sum / 0.9375;
}

// Boyer-Lindquist phi in the equator, prograde about +y; see Kerr::azimuth
float azimuth(vec3 hit, float r) {
    float a = tracedA();
    float phi = atan(hit.x, hit.z) - atan(a, r);
    float root = sqrt(max(uMass * uMass - a * a, 0.0));
    if (root == 0.0) {
        return phi + a / (r - uMass);
    }
    return phi - a / (2.0 * root) *
                     log((r - uMass - root) / (r - uMass + root));
}

// Gas clumps carried round at the local Keplerian rate
float diskDensity(vec3 hit, float r) {
    // Subtract the turn so far to get the start angle. Big chunk part only
    // changes every chunk; wrap it before adding the rest
    float rs = 2.0 * uMass;
    float rate = angularVelocity(r) * rs; // rad per rs / c
    float turned = mod(rate * uTimeChunks, kTwoPi) + rate * uTimeRest;
    float angle = azimuth(hit, r) - turned;
    // Circle in noise space: seamless in angle
    vec3 p = vec3(r / rs * kNoiseRadial, kNoiseAround * cos(angle),
                  kNoiseAround * sin(angle));
    return max(1.0 + kNoiseDepth * (2.0 * fbm(p) - 1.0), 0.0);
}

// Linear HDR radiance; tone mapped later
vec3 diskColor(vec3 hit, float r, float lambda, float cameraEnergy) {
    // Positive in exact arithmetic, also for E < 0; max guards log, pow
    float temperature =
        max(redshiftFactor(r, lambda, cameraEnergy), 0.0) * diskTemperature(r);
    // Clamped: near the horizon the blueshift overflows half floats
    return min(blackbody(temperature * kDiskPeakKelvin) * kDiskBrightness *
                   pow(temperature, 4.0) * diskDensity(hit, r),
               vec3(kMaxRadiance));
}

// pos, mom: Kerr-Schild position and covariant momentum (E = 1) of the
// time-reversed photon leaving the camera. direction: sign of its energy;
// for E < 0, mom points back along the ray (see Photon in Kerr.hpp)
vec3 trace(vec3 pos, vec3 mom, float cameraEnergy, float direction) {
    // Real photon: L_y / E = -(mom . d(pos)/d(phi))
    float lambda = -dot(mom, vec3(pos.z, 0.0, -pos.x));
    float a = tracedA();

    for (int i = 0; i < kMaxSteps; ++i) {
        vec3 p1, m1, p2, m2, p3, m3, p4, m4;
        float r, unused;
        derivative(pos, mom, p1, m1, r);
        if (r <= uHorizon) {
            return vec3(0.0);
        }
        float distance = length(pos);
        if (distance >= uEscapeRadius && direction * dot(pos, p1) > 0.0) {
            // Level 0: no derivatives in divergent flow
            return textureLod(uSkybox, normalize(direction * p1), 0.0).rgb;
        }
        float dt = direction * kStepFraction * distance / length(p1);
        derivative(pos + p1 * dt / 2.0, mom + m1 * dt / 2.0, p2, m2, unused);
        derivative(pos + p2 * dt / 2.0, mom + m2 * dt / 2.0, p3, m3, unused);
        derivative(pos + p3 * dt, mom + m3 * dt, p4, m4, unused);
        vec3 prev = pos;
        pos += (p1 + 2.0 * p2 + 2.0 * p3 + p4) * dt / 6.0;
        mom += (m1 + 2.0 * m2 + 2.0 * m3 + m4) * dt / 6.0;

        // Crossed the disk plane (y = 0) this step
        if (prev.y * pos.y <= 0.0 && prev.y != pos.y) {
            vec3 hit = mix(prev, pos, prev.y / (prev.y - pos.y));
            // In the equator r^2 = x^2 + z^2 - a^2
            float rHit = sqrt(max(dot(hit.xz, hit.xz) - a * a, 0.0));
            if (rHit >= uDiskInner && rHit <= uDiskOuter) {
                return diskColor(hit, rHit, lambda, cameraEnergy);
            }
        }
    }
    return vec3(0.0); // still orbiting
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOutput);
    if (any(greaterThanEqual(pixel, size))) {
        return; // partial edge group
    }
    if (!uCameraOutside) {
        imageStore(uOutput, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    // Pixel center, as a fragment shader would see it
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 view = normalize(
        vec3(ndc.x * uTanHalfFov * uAspect, ndc.y * uTanHalfFov, 1.0));
    // Moves along view at the speed of light: p = u + n
    vec4 p = uFrameTime + view.x * uFrameRight + view.y * uFrameUp +
             view.z * uFrameForward;
    float energy = -p.w; // rescale to E = 1
    // E = 0 (in the ergosphere): never escapes, call it captured
    vec3 color = energy == 0.0 ? vec3(0.0)
                               : trace(uCameraPos, p.xyz / energy,
                                       1.0 / energy, sign(energy));
    imageStore(uOutput, pixel, vec4(color, 1.0));
}
