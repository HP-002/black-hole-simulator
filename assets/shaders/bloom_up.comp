#version 430 core
// uTarget += 3x3 tent blur of the next smaller level
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform image2D uTarget;

uniform sampler2D uSource;

vec3 tap(vec2 uv, vec2 texel, float x, float y) {
    return textureLod(uSource, uv + vec2(x, y) * texel, 0.0).rgb;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uTarget);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(textureSize(uSource, 0));

    // Weights 1 2 1 / 2 4 2 / 1 2 1, over 16
    vec3 blur = tap(uv, texel, 0.0, 0.0) * 4.0 +
                (tap(uv, texel, -1.0, 0.0) + tap(uv, texel, 1.0, 0.0) +
                 tap(uv, texel, 0.0, -1.0) + tap(uv, texel, 0.0, 1.0)) * 2.0 +
                tap(uv, texel, -1.0, -1.0) + tap(uv, texel, 1.0, -1.0) +
                tap(uv, texel, -1.0, 1.0) + tap(uv, texel, 1.0, 1.0);

    vec3 sum = imageLoad(uTarget, pixel).rgb + blur / 16.0;
    imageStore(uTarget, pixel, vec4(sum, 1.0));
}
